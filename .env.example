# Verbose (DEBUG-level) logging (optional, default: false)
# DEBUG=true

# Telegram Bot Configuration
BOT_TOKEN=your_bot_token_here

# PostgreSQL settings for Docker compose
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=emoji-saver

# Database URL (required) — Postgres in the Docker compose network
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/emoji-saver
